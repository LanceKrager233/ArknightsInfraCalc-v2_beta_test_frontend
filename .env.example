# Authentication is initialized lazily; these are required only for auth requests and migrations.
DATABASE_URL=postgresql://arknights_runtime:change-me@127.0.0.1:55433/arknights_infra_auth
DATABASE_MIGRATION_URL=postgresql://arknights_migration:change-me@127.0.0.1:55433/arknights_infra_auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:5174
BETTER_AUTH_ADMIN_USER_IDS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=基建排班助手 <auth@example.com>
